{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "DevGo",
	"mainBinaryName": "DevGo",
	"version": "1.1.0",
	"identifier": "app.zetta.devgo",
	"build": {
		"beforeDevCommand": "bun run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "bun run build",
		"frontendDist": "../dist"
	},
	"app": {
		"macOSPrivateApi": true,
		"windows": [
			{
				"title": "DevGo",
				"create": false,
				"width": 900,
				"height": 720,
				"resizable": true,
				"maximized": true,
				"decorations": false,
				"transparent": false,
				"center": true,
				"visible": false
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"windows": {
			"nsis": {
				"installerIcon": "icons/icon.ico",
				"uninstallerIcon": "icons/icon.ico"
			}
		},
		"category": "DeveloperTool",
		"publisher": "Joy Ahmed",
		"homepage": "https://github.com/joyahmed/devgo",
		"license": "MIT",
		"shortDescription": "One keystroke to where you work.",
		"longDescription": "A launcher for a developer's projects. Point it at the folders that hold them, on every filesystem the machine can see, and it lists every project, finds one in a few keystrokes, and opens it in the editor, terminal or agent you already use.",
		"linux": {
			"deb": {
				"section": "devel"
			}
		}
	}
}
